# Copy to .env for local development, or to configure a self-hosted install —
# see docker-compose.yml's header comment for the two ways to run it.
# Never commit the real .env.
#
# ${VAR} references below are expanded by dotenv-expand for `pnpm dev` running
# natively on the host (see apps/api/src/config/env.ts), and separately by
# Docker Compose's own substitution when read as docker-compose.yml. Change
# the parts (PG_USER, PG_HOST_PORT, ...), not the composed URLs, and they
# both stay correct automatically.
#
# PG_HOST_IP/REDIS_HOST_IP double as the Docker port-bind address AND the host
# the native app connects to — keep them a real IP (127.0.0.1), not "localhost".

NODE_ENV=development
PORT=3000

# "no" for local dev (the default below); set to "unless-stopped" for a
# self-hosted/production install so the stack survives a reboot or crash.
RESTART_POLICY=no

# Where Postgres/Redis's bind-mounted data lives on the host (as <dir>/pgdb,
# <dir>/redis) — easy for a self-hosting operator to find and back up.
DATA_STORE=./data

# Postgres — used to initialize the postgres container AND to build the
# DATABASE_URL below. The containerized api ignores PG_HOST_IP/PG_HOST_PORT;
# docker-compose.yml points it at the `postgres` service directly instead.
PG_USER=akaunta
PG_PASSWORD=change-me
PG_DBNAME=akaunta
PG_HOST_IP=127.0.0.1
PG_HOST_PORT=5432
DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST_IP}:${PG_HOST_PORT}/${PG_DBNAME}
# Optional read replica; defaults to DATABASE_URL when unset (see Scalability section of the plan)
DATABASE_READ_URL=

# Redis — used for the ACL user docker-compose.yml creates AND to build
# REDIS_URL below. Same native-vs-container split as Postgres above.
REDIS_USERNAME=akaunta
REDIS_PASSWORD=change-me
REDIS_HOST_IP=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_URL=redis://${REDIS_USERNAME}:${REDIS_PASSWORD}@${REDIS_HOST_IP}:${REDIS_HOST_PORT}

# Which interface the api's own port binds to. 127.0.0.1 (the default in
# docker-compose.yml) is right when a reverse proxy on the same host sits in
# front of it; set to 0.0.0.0 to expose it directly.
API_HOST_IP=127.0.0.1
# The URL the *browser* uses to reach the API — baked into the web app's
# client bundle at build time (see apps/web/Dockerfile), so this isn't a
# Docker service name. Change it to this host's real IP or domain if the web
# app will be opened from another machine, not just this one.
API_PUBLIC_URL=http://localhost:3000
# Which interface the web app's own port binds to — same reasoning as API_HOST_IP.
WEB_HOST_IP=127.0.0.1

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Third-party integrations (leave blank to run with those features disabled locally)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
SMS_API_KEY=
SENTRY_DSN=
